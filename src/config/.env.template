# .env.template
# Copy this file to src/config/.env and fill in real values before running the app.
# DO NOT commit your real .env to source control.

# Application port
PORT=3000

# MongoDB connection configuration
MONGOURL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DBNAME=phoenix
DBUSER=your_db_user
DBPASS=your_db_password
DBAUTHMECHANISM=DEFAULT

# JWT configuration
# Secret used to sign access tokens (keep secret, use a strong random string)
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
# How long the access token is valid (example: 15m, 1h, 1d)
JWT_LIFETIME=15m
# Secret used to sign refresh tokens (must be different from JWT_SECRET)
REFRESH_TOKEN_SECRET=your_refresh_token_secret_different_from_jwt_secret
# How long the refresh token is valid (example: 7d, 30d)
JWT_REFRESH_LIFETIME=7d

# GitHub OAuth credentials (optional - for GitHub login)
# Create an OAuth App in GitHub and set the callback URL to
# http://localhost:3000/api/v1/auth/github/callback (adjust for production)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Frontend URL (used for CORS or redirects if needed)
FRONTEND_URL=http://localhost:3000

# Telegram bot notifications (optional — used by the daily room payment-status alert)
# Create a bot via @BotFather, then add it to a chat/group and send it a message.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
# Hour (0-23, server local time) to send the daily payment-status alert (default 9 = 09:00)
REPORT_HOUR=9

# Environment
NODE_ENV=development
